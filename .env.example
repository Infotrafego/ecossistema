# ═══════════════════════════════════════════════════════════════
# Ecossistema Infotráfego · variáveis de ambiente
# ═══════════════════════════════════════════════════════════════
# Local: copie pra .env.local e preencha.
# Produção: veja onde cada var entra no fluxo de deploy abaixo.
#
#   ┌─────────────────────────────────────────────────────────────┐
#   │ BUILD-TIME (NEXT_PUBLIC_*) → embutidas no bundle no build.   │
#   │   → vão como GitHub Secrets, usadas no .github/workflows.    │
#   │   → são PÚBLICAS (vão pro browser). A anon key é pública     │
#   │     por design; o RLS é quem protege os dados.               │
#   ├─────────────────────────────────────────────────────────────┤
#   │ RUNTIME (resto) → segredos de servidor, NUNCA no bundle.     │
#   │   → preenchidas no Portainer (Environment variables).        │
#   └─────────────────────────────────────────────────────────────┘

# ═══ Supabase · BUILD-TIME (públicas) ═══
# Projeto "Infotráfego" · ref jcserimdehwyxghdgmgj · schema infotrafego_ecossistema
NEXT_PUBLIC_SUPABASE_URL=https://jcserimdehwyxghdgmgj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ═══ App · BUILD-TIME (pública) ═══
# Local: http://localhost:3000 · Prod: https://ecossistema.servidordainfotrafego.com.br
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ═══ Supabase · RUNTIME (segredo) ═══
# Dashboard → Settings → API → service_role (secret). NUNCA expor ao client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ═══ Claude API · RUNTIME (segredo) ═══
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ═══ Meta Marketing API · RUNTIME (segredo) ═══
# https://developers.facebook.com/apps/[SEU_APP]/dashboard
# System User token (longa duração) recomendado pra produção.
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

# Versão da Graph API. Subir só depois de conferir o changelog: a Meta remove
# campos entre versões e o sync quebra silenciosamente (campo some, vira 0).
META_API_VERSION=v21.0

# ─── Controle de cota (o limite inicial é ~200 chamadas/hora/usuário) ───
# Teto por execução de sync. Ao atingir, o sync PARA sozinho e registra
# `partial` no sync_log — o que já foi gravado continua válido.
META_MAX_CALLS_PER_RUN=150
# Espaçamento mínimo entre chamadas, em ms. Evita rajada.
META_MIN_CALL_INTERVAL_MS=250
META_MAX_RETRIES=4

# ─── ⚠ TRAVA DE ESCRITA (Fase 2b) ───────────────────────────────────────
# As ações da action toolbar (pausar, duplicar, mexer em orçamento) GASTAM
# VERBA DE CLIENTE REAL. Só as contas listadas aqui aceitam escrita; qualquer
# outra é recusada e a tentativa fica registrada no audit_log.
#
# Deixar VAZIO = nenhuma escrita é permitida. É o padrão, e é o certo até o
# Pablo liberar conta por conta.
#   META_WRITE_ALLOWED_ACCOUNTS=act_1234567890
META_WRITE_ALLOWED_ACCOUNTS=
# Contas marcadas como sandbox no log de auditoria (informativo).
META_SANDBOX_ACCOUNTS=

# ═══ Sync diário · RUNTIME ═══
# O cron roda DENTRO do container (ver lib/meta-ads/agendador.ts pro porquê).
# Requer `replicas: 1` na stack — está assim no docker-stack.yml.
SYNC_CRON_ENABLED=false
# Hora UTC da janela. 7 = 04h de Brasília.
SYNC_HORA_UTC=7
# Segredo pra disparar POST /api/sync/meta de fora (agendador externo).
# Sem ele, só admin logado dispara.
SYNC_SECRET=

# ═══ ClickUp · RUNTIME (segredo · opcional na Fase 2) ═══
CLICKUP_API_TOKEN=
